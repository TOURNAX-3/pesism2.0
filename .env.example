# Copy to .env.local (web) and apps/bot/.env (bot). Never commit real values.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server and bot only

# WhatsApp bot
WA_GROUP_JID=1203630xxxxxxxxx@g.us   # the tournament group's id, logged by the bot on first run
WA_ADMIN_NUMBERS=919876543210        # comma separated, no plus sign
CONFIRM_TIMEOUT_HOURS=12
