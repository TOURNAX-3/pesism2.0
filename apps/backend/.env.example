ADMIN_API_KEY=dev-admin-change-me

DATABASE_URL=jdbc:postgresql://db.YOUR_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_USER=postgres
DATABASE_PASSWORD=your-db-password

# --- Brevo (free tier ~300 emails/day) ---
# Production (Railway etc.): use HTTPS API — outbound SMTP port 587 is often blocked.
# Dashboard → SMTP & API → API keys → create key (xkeysib-…)
BREVO_API_KEY=xkeysib-xxxxxxxx
MAIL_FROM=TOURNAX <auradevbusiness@gmail.com>

# Local dev: SMTP is fine on your machine
BREVO_SMTP_LOGIN=xxxxxxxx@smtp-brevo.com
BREVO_SMTP_KEY=xsmtpsib-xxxxxxxx

# Optional alternatives (Resend HTTP or generic SMTP)
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_ENABLED=true
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Dev only: log OTP in console (omit Brevo/Resend keys)
# MAIL_DELIVERY=console
